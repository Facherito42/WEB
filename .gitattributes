# Estos archivos corren en el servidor Linux — SIEMPRE con saltos de línea LF,
# aunque se editen o transfieran desde Windows (un CRLF rompe bash/systemd).
*.sh            text eol=lf
*.py            text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
*.conf          text eol=lf
api/**          text eol=lf
*.png           binary
*.jpg           binary
*.jpeg          binary
*.svg           text
*.mp4           binary
