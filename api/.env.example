# Copiar a .env y completar. NO commitear .env.
FTP_HOST=192.168.100.96
FTP_USER=geodesia
FTP_PASS=PONER_LA_CLAVE
FTP_ROOT=/home/igmrou/ftp/regna
FTP_SUBDIR=Diario

# Rutas locales en la VM (Windows). Podés dejar estas por defecto.
DATA_DIR=C:\rinex-api\data
CACHE_DIR=C:\rinex-api\cache

# Tope del caché de archivos traídos del FTP.
CACHE_MAX_GB=8

# Origen del sitio para CORS. Vacío si IIS sirve sitio + API bajo el mismo dominio.
# Ej: https://mi-sitio.vercel.app
ALLOW_ORIGIN=

# Puerto local donde escucha uvicorn (IIS/ARR hace de reverse proxy delante).
PORT=8000
