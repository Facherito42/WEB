# Copiar a .env y ajustar. NO commitear .env.
# En el servidor va en /opt/rinex-api/.env

# --- FTP de datos ---
FTP_HOST=192.168.100.96
FTP_USER=anonymous
FTP_PASS=rinex@igm.gub.uy
# Carpeta raíz dentro del FTP (con login anónimo, las estaciones cuelgan de /regna)
FTP_ROOT=/regna
# Subcarpeta con el archivo diario por estación/día
FTP_SUBDIR=Diario
# Estaciones internas / de prueba que NO se publican (coma-separado)
EXCLUDE_STATIONS=IM03,IM13,IM17,IM35,SNM1

# --- Rutas locales (el servicio systemd usa /var/lib/rinex-api) ---
DATA_DIR=/var/lib/rinex-api/data
CACHE_DIR=/var/lib/rinex-api/cache
CACHE_MAX_GB=8

# --- API ---
# Vacío si Nginx sirve el sitio y la API bajo el mismo dominio.
ALLOW_ORIGIN=
PORT=8000
TRUST_PROXY=1

# --- Límites de abuso ---
RATE_DOWNLOAD=30
RATE_MANIFEST=60
MAX_FILE_MB=200
MAX_CONCURRENT_FTP=4
