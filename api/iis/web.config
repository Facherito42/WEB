<?xml version="1.0" encoding="UTF-8"?>
<!--
  Colocar en la RAIZ del sitio IIS (junto al build de React).
  Requiere los modulos: URL Rewrite + Application Request Routing (ARR).
  En ARR: "Server Proxy Settings" -> Enable proxy.

  Cubre: reverse proxy a la API, fallback SPA, cabeceras de seguridad,
  y ocultar cabeceras que revelan la version del servidor.
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>
        <!-- /rinex-data/* -> API FastAPI en localhost -->
        <rule name="api-proxy" stopProcessing="true">
          <match url="^rinex-data/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/rinex-data/{R:1}" />
        </rule>
        <!-- El resto: si no es archivo/carpeta real, servir el SPA -->
        <rule name="spa-fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
      <!-- No filtrar la IP interna del servidor en respuestas de error del proxy -->
      <outboundRules>
        <rule name="strip-server" preCondition="is-response" patternSyntax="Wildcard">
          <match serverVariable="RESPONSE_Server" pattern="*" />
          <action type="Rewrite" value="" />
        </rule>
        <preConditions>
          <preCondition name="is-response">
            <add input="{RESPONSE_STATUS}" pattern=".*" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <!-- Fuerza HTTPS por 2 anios en navegadores (activar SOLO cuando el
             dominio ya sirve 100% por HTTPS, si no rompe el acceso) -->
        <add name="Strict-Transport-Security" value="max-age=63072000; includeSubDomains" />
        <!-- No adivinar el tipo de contenido -->
        <add name="X-Content-Type-Options" value="nosniff" />
        <!-- No permitir que el sitio se embeba en iframes de terceros -->
        <add name="X-Frame-Options" value="DENY" />
        <!-- Cuanta info de origen se manda al navegar a otros sitios -->
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <!-- Desactiva APIs del navegador que el sitio no usa -->
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=(), usb=()" />
        <!-- Politica de contenido. Ajustar si se agregan recursos externos.
             Origenes externos actuales: Google Fonts y tiles de OpenStreetMap.
             script-src incluye 'unsafe-inline' porque vite-react-ssg genera un
             pequenio <script> de hidratacion embebido en cada pagina. El sitio
             no tiene entradas de usuario ni contenido dinamico, asi que el
             riesgo de XSS es minimo. Para endurecerlo mas adelante habria que
             post-procesar el build inyectando hashes/nonce. -->
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.tile.openstreetmap.org; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests" />
      </customHeaders>
      <redirectHeaders>
        <clear />
      </redirectHeaders>
    </httpProtocol>

    <!-- Oculta "X-Powered-By: ASP.NET" -->
    <security>
      <requestFiltering removeServerHeader="true">
        <!-- Permitir descargas grandes (RINEX historicos, por las dudas) -->
        <requestLimits maxAllowedContentLength="4294967295" />
        <!-- Bloquea rutas ocultas y de sistema -->
        <hiddenSegments>
          <add segment=".git" />
          <add segment=".env" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- Sin listado de directorios -->
    <directoryBrowse enabled="false" />

    <!-- Cache de assets estaticos con hash en el nombre -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>

    <httpErrors errorMode="Custom" existingResponse="Auto" />

  </system.webServer>
</configuration>
