[Unit]
Description=RINEX download API (FastAPI/uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rinex
Group=rinex
WorkingDirectory=/opt/rinex-api
EnvironmentFile=/opt/rinex-api/.env
ExecStart=/opt/rinex-api/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8000 \
    --no-server-header --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=3

# Endurecimiento
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rinex-api
StateDirectory=rinex-api

[Install]
WantedBy=multi-user.target
