[Unit]
Description=Reconstruye el índice RINEX (rinex.json) desde el FTP

[Service]
Type=oneshot
User=rinex
Group=rinex
WorkingDirectory=/opt/rinex-api
EnvironmentFile=/opt/rinex-api/.env
ExecStart=/opt/rinex-api/venv/bin/python -m app.indexer
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rinex-api
