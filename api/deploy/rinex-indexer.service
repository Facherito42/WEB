[Unit]
Description=Reconstruye el índice RINEX (index.json + y/<año>.json) desde las fuentes

[Service]
Type=oneshot
User=rinex
Group=rinex
WorkingDirectory=/opt/rinex-api
EnvironmentFile=/opt/rinex-api/.env
ExecStart=/opt/rinex-api/venv/bin/python -m app.indexer
# El primer run (o --full) recorre el SFTP histórico entero: puede tardar mucho.
TimeoutStartSec=infinity
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rinex-api
